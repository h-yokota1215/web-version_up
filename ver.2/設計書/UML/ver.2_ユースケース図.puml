@startuml ver2_usecase
title juchu01 ver.2 ユースケース図

left to right direction
skinparam packageStyle rectangle

actor "法人顧客" as Customer
actor "営業所在庫DB" as StockDB
actor "商品マスタ管理者" as Admin

rectangle "juchu01 ver.2" {
  usecase "商品カテゴリを選択する" as UC01
  usecase "商品サブカテゴリを選択する" as UC02
  usecase "商品一覧を検索する" as UC03
  usecase "商品共通項目を確認する" as UC04
  usecase "商品詳細を確認する" as UC05
  usecase "商品固有項目を確認する" as UC06
  usecase "商品画像を確認する" as UC07
  usecase "在庫を確認する" as UC08
  usecase "商品をカートへ追加する" as UC09
  usecase "新商品を受注する" as UC10
  usecase "商品カテゴリ・商品を登録する" as UC11
  usecase "営業所別在庫を登録する" as UC12
}

Customer --> UC01
Customer --> UC02
Customer --> UC03
Customer --> UC05
Customer --> UC09
Customer --> UC10

UC03 .> UC02 : <<include>>
UC03 .> UC04 : <<include>>
UC03 .> UC08 : <<include>>
UC05 .> UC04 : <<include>>
UC05 .> UC06 : <<include>>
UC05 .> UC07 : <<include>>
UC09 .> UC08 : <<include>>
UC10 .> UC08 : <<include>>

Admin --> UC11
Admin --> UC12
UC08 --> StockDB

note right of UC06
  Foods / Av / Pcの固有項目を表示
end note

note bottom of UC10
  既存のカート・受注・在庫引当処理を利用する
end note

@enduml
